{
  "name": "qagent-catalog",
  "version": "0.11.1",
  "description": "QAgent Knowledge Layer - tenant-aware read-only Catalog Query API.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run typecheck",
    "deploy": "npm run check && wrangler deploy",
    "cf-types": "npm run verify:bindings && wrangler types",
    "typecheck": "npm run cf-types && tsc --noEmit",
    "test": "npm run cf-types && vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && vitest run",
    "verify:bindings": "node scripts/verify-bindings.mjs",
    "sign:query": "node scripts/sign-query-request.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.121.0"
  }
}
